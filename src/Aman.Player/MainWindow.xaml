<Window x:Class="Aman.Player.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Aman.Player.Converters"
        Title="{Binding Title}"
        Height="760" Width="1200" MinHeight="480" MinWidth="720"
        FlowDirection="{Binding Loc.FlowDirection}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
    </Window.Resources>

    <Grid>

        <!-- Fatal error (bad/corrupt/tampered package) -->
        <Grid Visibility="{Binding HasFatalError, Converter={StaticResource BoolToVis}}" Background="{DynamicResource WindowBackgroundBrush}">
            <TextBlock Text="{Binding FatalError}" Foreground="{DynamicResource DangerBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="600" TextAlignment="Center" />
        </Grid>

        <!-- Unlock screen -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasFatalError}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Style="{StaticResource Panel}" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Image Source="{Binding Logo}" MaxHeight="70" Margin="0,0,0,16"
                           Visibility="{Binding Logo, Converter={StaticResource NullToVis}}" />
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" />

                    <TextBlock Text="{Binding Loc[unlock_title]}" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <PasswordBox x:Name="PasswordBox1" Margin="0,0,0,14" PasswordChanged="PasswordBox1_PasswordChanged" />

                    <StackPanel Visibility="{Binding RequireActivationCode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Loc[your_machine_id]}" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding MachineIdDisplay, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" />
                            <Button Grid.Column="1" Content="{Binding Loc[copy]}" Margin="6,0,0,0" Click="CopyMachineId_Click" />
                        </Grid>

                        <TextBlock Text="{Binding Loc[unlock_activation_title]}" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ActivationCode, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Margin="0,0,0,14" />
                    </StackPanel>

                    <Button Content="{Binding Loc[unlock_button]}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding UnlockCommand}" HorizontalAlignment="Stretch" />

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                               Margin="0,10,0,0" TextWrapping="Wrap" HorizontalAlignment="Center" />

                    <TextBlock Text="{Binding Loc[protected_notice]}" Style="{StaticResource MutedText}"
                               Margin="0,20,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Border>

            <Button Content="{Binding Loc[language_toggle]}" Command="{Binding ToggleLanguageCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" />
        </Grid>

        <!-- Player -->
        <Grid Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="Black">
                <Border x:Name="VideoArea" AllowDrop="False" ContextMenu="{x:Null}"
                        PreviewMouseRightButtonDown="Video_PreviewMouseRightButtonDown"
                        MouseLeftButtonDown="Video_MouseLeftButtonDown"
                        PreviewMouseMove="VideoArea_PreviewMouseMove">
                    <Grid>
                        <MediaElement x:Name="Media" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                      Stretch="Uniform" MediaOpened="Media_MediaOpened" MediaEnded="Media_MediaEnded" />

                        <!-- Traceability watermark: a leaked recording still carries this device's id. -->
                        <TextBlock x:Name="Watermark" Text="{Binding MachineIdDisplay}" Foreground="#33FFFFFF"
                                   FontSize="13" Margin="12" IsHitTestVisible="False" />

                        <Grid x:Name="ControlsBar" VerticalAlignment="Bottom" Background="#AA000000"
                              MouseEnter="ControlsBar_MouseEnter" MouseLeave="ControlsBar_MouseLeave">
                            <StackPanel Margin="16,10">
                                <Slider x:Name="SeekSlider" Minimum="0" Maximum="1"
                                        PreviewMouseDown="SeekSlider_PreviewMouseDown" PreviewMouseUp="SeekSlider_PreviewMouseUp" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="PreviousButton" Style="{StaticResource TransportButton}" Content="⏮" Click="Previous_Click" />
                                        <Button x:Name="PlayPauseButton" Style="{StaticResource TransportButton}" Content="▶" Click="PlayPause_Click" />
                                        <Button x:Name="NextButton" Style="{StaticResource TransportButton}" Content="⏭" Click="Next_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="TimeLabel" Grid.Column="1" Text="00:00 / 00:00"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔊" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="0.8" Width="90"
                                                ValueChanged="VolumeSlider_ValueChanged" />
                                        <Button x:Name="FullscreenButton" Style="{StaticResource TransportButton}" Content="⛶"
                                                Click="Fullscreen_Click" Margin="10,0,0,0" ToolTip="Fullscreen" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource Panel}" CornerRadius="0" Margin="0">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[playlist]}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                    <ListBox ItemsSource="{Binding Playlist}" SelectedItem="{Binding SelectedEntry}" DisplayMemberPath="Title" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
