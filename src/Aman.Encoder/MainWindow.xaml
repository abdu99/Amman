<Window x:Class="Aman.Encoder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Aman.Encoder.ViewModels"
        xmlns:conv="clr-namespace:Aman.Encoder.Converters"
        Title="{Binding Loc[encoder_title]}"
        Height="820" Width="1180" MinHeight="640" MinWidth="980"
        FlowDirection="{Binding Loc.FlowDirection}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:EnumToBooleanConverter x:Key="EnumToBool" />
        <conv:ZeroToVisibilityConverter x:Key="CountToVis" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Loc[app_name]}" FontSize="26" FontWeight="Bold" />
                <TextBlock Text=" — " FontSize="26" Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock Text="Encoder" FontSize="26" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{Binding Loc[language_toggle]}" Command="{Binding ToggleLanguageCommand}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding VendorPublicKeyFingerprint, StringFormat='Vendor Key: {0}'}"
                           Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0" />
            </StackPanel>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Playlist -->
            <Border Style="{StaticResource Panel}" Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Loc[playlist]}" Style="{StaticResource SectionTitle}" />
                        <Button Grid.Column="1" Content="{Binding Loc[add_videos]}" Command="{Binding AddVideosCommand}" />
                    </Grid>

                    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1.5"
                            CornerRadius="8" Margin="0,10,0,10" Padding="14" Background="{DynamicResource PanelAltBackgroundBrush}">
                        <TextBlock Text="{Binding Loc[drop_videos_hint]}" HorizontalAlignment="Center"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center" />
                    </Border>

                    <ListBox Grid.Row="2" x:Name="PlaylistBox" ItemsSource="{Binding Videos}"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="PlaylistBox_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="PlaylistBox_PreviewMouseMove"
                             Drop="PlaylistBox_Drop">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:VideoItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent" Padding="0" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                        <Button Content="▲" Width="28" Margin="2,0"
                                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="▼" Width="28" Margin="2,0"
                                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource DangerButton}"
                                            Content="{Binding DataContext.Loc[remove], RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            Command="{Binding DataContext.RemoveVideoCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Settings -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[protection_settings]}" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="{Binding Loc[password]}" Style="{StaticResource MutedText}" />
                            <PasswordBox x:Name="PasswordBox1" Margin="0,4,0,10" PasswordChanged="PasswordBox1_PasswordChanged" />

                            <TextBlock Text="{Binding Loc[confirm_password]}" Style="{StaticResource MutedText}" />
                            <PasswordBox x:Name="PasswordBox2" Margin="0,4,0,10" PasswordChanged="PasswordBox2_PasswordChanged" />

                            <TextBlock Text="{Binding Loc[protection_mode]}" Style="{StaticResource MutedText}" Margin="0,6,0,4" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton GroupName="Mode" Content="{Binding Loc[mode_password_only]}" Margin="0,0,16,0"
                                             IsChecked="{Binding SelectedProtectionMode, Converter={StaticResource EnumToBool}, ConverterParameter=PasswordOnly}" />
                                <RadioButton GroupName="Mode" Content="{Binding Loc[mode_activation_code]}"
                                             IsChecked="{Binding SelectedProtectionMode, Converter={StaticResource EnumToBool}, ConverterParameter=ActivationCode}" />
                            </StackPanel>

                            <CheckBox Content="{Binding Loc[expiry_enabled]}" IsChecked="{Binding IsExpiryEnabled}" Margin="0,4" />
                            <DatePicker SelectedDate="{Binding ExpiryDate}" IsEnabled="{Binding IsExpiryEnabled}" Margin="0,0,0,10" />

                            <CheckBox Content="{Binding Loc[max_runs_enabled]}" IsChecked="{Binding IsMaxRunsEnabled}" Margin="0,4" />
                            <TextBox Text="{Binding MaxRunsValue}" IsEnabled="{Binding IsMaxRunsEnabled}" Width="80" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[branding]}" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="{Binding Loc[player_title]}" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding PlayerTitle}" Margin="0,4,0,10" />

                            <TextBlock Text="{Binding Loc[logo]}" Style="{StaticResource MutedText}" />
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding LogoPath}" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="…" Width="36" Margin="6,0,0,0" Command="{Binding BrowseLogoCommand}" />
                            </Grid>

                            <TextBlock Text="{Binding Loc[accent_color]}" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding AccentColorHex}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[build_history]}" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="{Binding Loc[build_history_empty]}" Style="{StaticResource MutedText}"
                                       Visibility="{Binding BuildHistory.Count, Converter={StaticResource CountToVis}}" />

                            <ItemsControl ItemsSource="{Binding BuildHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding PackageId}" Style="{StaticResource MutedText}" FontFamily="Consolas" />
                                                    <TextBlock Text="{Binding BuiltUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Style="{StaticResource MutedText}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{Binding DataContext.Loc[copy], RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Command="{Binding DataContext.CopyPackageIdCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" Margin="6,0" VerticalAlignment="Center" />
                                                <Button Grid.Column="2" Content="{Binding DataContext.Loc[use_for_activation], RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Command="{Binding DataContext.UseForActivationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[generate_activation_code]}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Package ID" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding ActCodePackageId}" Margin="0,4,0,10" />

                            <TextBlock Text="{Binding Loc[machine_id_input]}" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding ActCodeMachineId}" Margin="0,4,0,10" />

                            <CheckBox Content="{Binding Loc[expiry_enabled]}" IsChecked="{Binding ActCodeExpiryEnabled}" Margin="0,4" />
                            <DatePicker SelectedDate="{Binding ActCodeExpiryDate}" IsEnabled="{Binding ActCodeExpiryEnabled}" Margin="0,0,0,10" />

                            <CheckBox Content="{Binding Loc[max_runs_enabled]}" IsChecked="{Binding ActCodeMaxRunsEnabled}" Margin="0,4" />
                            <TextBox Text="{Binding ActCodeMaxRunsValue}" IsEnabled="{Binding ActCodeMaxRunsEnabled}" Width="80" HorizontalAlignment="Left" Margin="0,0,0,10" />

                            <Button Content="{Binding Loc[generate_activation_code]}" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding GenerateActivationCodeCommand}" HorizontalAlignment="Left" />

                            <TextBox Text="{Binding ActCodeResult, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     Margin="0,10,0,0" FontFamily="Consolas" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer / build -->
        <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <ProgressBar Value="{Binding BuildProgress, Mode=OneWay}" Maximum="100"
                                 Visibility="{Binding IsBuilding, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding Loc[build_package]}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding BuildPackageCommand}" FontSize="15" Padding="22,12" />
            </Grid>
        </Border>
    </Grid>
</Window>
