<Window x:Class="MultiDownloader.App.Views.AddDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة تنزيل" Height="330" Width="520" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" Background="{StaticResource BackgroundBrush}" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="الرابط (فيديو يوتيوب، صفحة موقع، أو رابط ملف مباشر):" Margin="0,0,0,4" />
        <TextBox x:Name="UrlTextBox" Padding="6" />

        <TextBlock Text="مجلد الحفظ:" Margin="0,12,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Left" Content="استعراض..." Style="{StaticResource SecondaryButton}" Click="Browse_Click" />
            <TextBox x:Name="FolderTextBox" Padding="6" />
        </DockPanel>

        <TextBlock Text="عدد الاتصالات المتزامنة (للملفات المباشرة فقط):" Margin="0,12,0,4" />
        <TextBox x:Name="ConnectionsTextBox" Text="8" Width="60" HorizontalAlignment="Right" Padding="6" />

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="جلب المعلومات واختيار الجودة" Click="Fetch_Click" x:Name="FetchButton" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="300" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,0">
            <Button Content="إضافة إلى قائمة التنزيل" Click="Add_Click" />
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
