<Window x:Class="MultiDownloader.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الإعدادات" Height="360" Width="500" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" Background="{StaticResource BackgroundBrush}" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="مجلد التنزيل الافتراضي:" Margin="0,0,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Left" Content="استعراض..." Style="{StaticResource SecondaryButton}" Click="Browse_Click" />
            <TextBox x:Name="FolderTextBox" Padding="6" />
        </DockPanel>

        <TextBlock Text="أقصى عدد تنزيلات متزامنة (لأكثر من مشروع في آنٍ واحد):" Margin="0,14,0,4" />
        <TextBox x:Name="MaxConcurrentTextBox" Width="60" HorizontalAlignment="Right" Padding="6" />

        <TextBlock Text="عدد الاتصالات الافتراضي لكل ملف مباشر:" Margin="0,14,0,4" />
        <TextBox x:Name="DefaultConnectionsTextBox" Width="60" HorizontalAlignment="Right" Padding="6" />

        <TextBlock Text="مسار yt-dlp.exe (اتركه فارغًا للاكتشاف/التنزيل التلقائي):" Margin="0,14,0,4" />
        <TextBox x:Name="YtDlpPathTextBox" Padding="6" />

        <TextBlock Text="مسار ffmpeg.exe (مطلوب لدمج فيديو+صوت منفصلين — اتركه فارغًا للاكتشاف التلقائي):" Margin="0,14,0,4" TextWrapping="Wrap" />
        <TextBox x:Name="FfmpegPathTextBox" Padding="6" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,0">
            <Button Content="حفظ" Click="Save_Click" />
            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
